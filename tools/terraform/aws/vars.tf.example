variable "aws_access_key" {
  type    = string
  default = ""
}

variable "aws_secret_key" {
  type    = string
  default = ""
}

variable "a-zone" {
  type    = string
  default = "us-east-1a"
}

variable "ami-id" {
  type    = string
  default = "ami-0ecb62995f68bb549"
}

variable "master_instance_type" {
  type    = string
  default = "t3.micro"
}

variable "agent_instance_type" {
  type        = string
  description = "Builds and runs the whole app stack, needs more RAM than the master"
  default     = "m7i-flex.large"
}

variable "key_name" {
  type    = string
  default = ""
}

variable "my_ip" {
  type        = string
  description = "Your public IP"
  default     = ""
}

variable "jenkins_admin_password" {
  type        = string
  description = "Password for the Jenkins admin user"
  default     = ""
}

variable "duckdns_subdomain" {
  type        = string
  description = "DuckDNS subdomain, must match server_name in front/nginx.server.conf"
  default     = "much-more-demo"
}

variable "duckdns_token" {
  type        = string
  description = "DuckDNS token, used to point the subdomain at the agent"
  default     = ""
}

variable "letsencrypt_email" {
  type        = string
  description = "Optional email for the Let's Encrypt account, leave empty for none"
  default     = ""
}

variable "letsencrypt_staging" {
  type        = bool
  description = "Use the Let's Encrypt staging server (untrusted cert, no rate limit) while testing"
  default     = false
}
